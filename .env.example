# ================================================================
# OxyPulse - Environment Variables
# Copy to .env and fill in your values
# ================================================================

# Telegram
TELEGRAM_TOKEN=<set-locally>
TELEGRAM_BOT_TOKEN=<set-locally>
OWNER_TELEGRAM_ID=your_telegram_user_id

# OKX API (Futures - disable withdrawal permission on the key)
OKX_API_KEY=<set-locally>
OKX_API_SECRET=<set-locally>
OKX_API_PASSPHRASE=your_okx_api_passphrase

# OpenAI / AI
OPENAI_API_KEY=<set-locally>
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=<set-locally>
TEMPERATURE=0.7

# Trading mode
PAPER_TRADING=True
FUTURES_LEVERAGE=5
FUTURES_MARGIN_MODE=isolated

# Risk engine
RISK_PCT=0.75
ATR_SL_MULTIPLIER=2.0
ATR_TP1_MULTIPLIER=4.0
ATR_TP2_MULTIPLIER=6.0
PARTIAL_EXITS=False

# Engine
SCAN_INTERVAL=30
MIN_CANDLES=50
MAX_PARALLEL_COINS=15
MIN_COIN_VOL_USD=50000

# Independent health-report email
REPORT_EMAIL_TO=you@example.com
REPORT_SMTP_HOST=smtp.example.com
REPORT_SMTP_PORT=465
REPORT_SMTP_USE_SSL=true
REPORT_SMTP_USERNAME=<set-locally>
REPORT_SMTP_PASSWORD=<set-locally>
REPORT_EMAIL_FROM=your_sending_address@example.com
